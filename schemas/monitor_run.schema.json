{
  "table": "monitor_run",
  "file": "monitor_run_sample.csv",
  "primary_key": ["monitor_run_id"],
  "unique": [],
  "foreign_keys": [
    {"columns": ["monitor_target_id"], "ref_table": "monitor_target", "ref_columns": ["monitor_target_id"]},
    {"columns": ["previous_run_id"], "ref_table": "monitor_run", "ref_columns": ["monitor_run_id"], "nullable": true}
  ],
  "columns": [
    {"name": "monitor_run_id", "type": "string", "required": true},
    {"name": "monitor_target_id", "type": "string", "required": true},
    {"name": "started_at", "type": "datetime", "required": true},
    {"name": "finished_at", "type": "datetime", "required": true},
    {"name": "run_result", "type": "enum", "required": true, "allowed": ["initialized", "no_change", "change_detected", "error", "skipped"]},
    {"name": "observation_status", "type": "enum", "required": true, "allowed": ["succeeded", "failed", "not_attempted"]},
    {"name": "error_code", "type": "enum", "required": false, "allowed": ["http_error", "timeout", "authentication_required", "rate_limited", "parse_error", "timestamp_parse_error", "content_ambiguous", "low_confidence", "source_unavailable", "unexpected_format", "terms_not_approved", "state_unavailable", "persistence_error"]},
    {"name": "error_detail", "type": "string", "required": false},
    {"name": "retry_count", "type": "integer", "required": true, "min": 0},
    {"name": "checkpoint_version_before", "type": "integer", "required": false, "min": 0},
    {"name": "checkpoint_version_after", "type": "integer", "required": false, "min": 1},
    {"name": "initialization_generation", "type": "integer", "required": false, "min": 1},
    {"name": "fingerprint_before", "type": "string", "required": false},
    {"name": "fingerprint_after", "type": "string", "required": false},
    {"name": "fingerprint_version", "type": "enum", "required": false, "allowed": ["metadata_v1"]},
    {"name": "detected_change_summary", "type": "string", "required": false},
    {"name": "persistence_status", "type": "enum", "required": true, "allowed": ["committed", "failed", "not_attempted"]},
    {"name": "notification_required", "type": "boolean", "required": true},
    {"name": "notification_status", "type": "enum", "required": true, "allowed": ["not_required", "pending", "delivered", "failed"]},
    {"name": "notification_error_code", "type": "enum", "required": false, "allowed": ["notification_error"]},
    {"name": "notification_reference", "type": "string", "required": false},
    {"name": "previous_run_id", "type": "string", "required": false},
    {"name": "recorded_by", "type": "string", "required": true}
  ]
}
