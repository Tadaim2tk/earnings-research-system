{
  "table": "post_earnings_review",
  "file": "post_earnings_review_sample.csv",
  "primary_key": ["review_id"],
  "unique": [["earnings_event_id", "baseline_id"]],
  "foreign_keys": [
    {"columns": ["earnings_event_id"], "ref_table": "earnings_event", "ref_columns": ["earnings_event_id"]},
    {"columns": ["baseline_id"], "ref_table": "pre_earnings_baseline", "ref_columns": ["baseline_id"]}
  ],
  "columns": [
    {"name": "review_id", "type": "string", "required": true},
    {"name": "earnings_event_id", "type": "string", "required": true},
    {"name": "baseline_id", "type": "string", "required": true},
    {"name": "actual_revenue", "type": "decimal", "required": false, "min": 0},
    {"name": "actual_operating_income", "type": "decimal", "required": false},
    {"name": "actual_eps", "type": "decimal", "required": false},
    {"name": "revenue_surprise_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "operating_income_surprise_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "eps_surprise_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "guidance_revision_type", "type": "enum", "required": true, "allowed": ["up", "down", "none", "unknown"]},
    {"name": "guidance_revision_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "key_kpi_result", "type": "string", "required": false},
    {"name": "earnings_quality_result", "type": "string", "required": false},
    {"name": "management_comment_assessment", "type": "string", "required": false},
    {"name": "initial_market_reaction", "type": "enum", "required": true, "allowed": ["positive", "negative", "mixed", "muted", "unknown"]},
    {"name": "return_reference_price_type", "type": "enum", "required": false, "allowed": ["previous_close", "pre_announcement_price", "announcement_day_close", "next_open", "vwap_after_announcement", "manual", "unknown"]},
    {"name": "return_reference_price", "type": "decimal", "required": false, "min": 0},
    {"name": "return_reference_price_datetime", "type": "datetime", "required": false},
    {"name": "open_gap_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "day0_return_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "day1_return_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "day5_return_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "day20_return_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "max_favorable_excursion_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "max_adverse_excursion_pct", "type": "decimal", "required": false, "min": -100, "max": 100},
    {"name": "post_event_score", "type": "decimal", "required": false, "min": 0, "max": 100},
    {"name": "post_event_grade", "type": "enum", "required": false, "allowed": ["A", "B", "C", "D", "NO_TRADE"]},
    {"name": "trade_decision", "type": "enum", "required": true, "allowed": ["LONG", "SHORT", "WATCH", "NO_TRADE"]},
    {"name": "trade_entry", "type": "decimal", "required": false, "min": 0},
    {"name": "stop_loss", "type": "decimal", "required": false, "min": 0},
    {"name": "take_profit", "type": "decimal", "required": false, "min": 0},
    {"name": "decision_reason", "type": "string", "required": true},
    {"name": "hypothesis_result", "type": "enum", "required": true, "allowed": ["supported", "mixed", "invalidated", "pending"]},
    {"name": "review_status", "type": "enum", "required": true, "allowed": ["draft", "reviewed", "closed"]},
    {"name": "scoring_version", "type": "string", "required": true},
    {"name": "recorded_at", "type": "datetime", "required": true}
  ]
}
