    {"name": "content_hash_algorithm", "type": "enum", "required": false, "header_required": false, "allowed": ["sha256"]},
    {"name": "raw_storage_status", "type": "enum", "required": false, "header_required": false, "allowed": ["stored", "metadata_only", "storage_prohibited", "storage_pending_review", "unavailable"]},
    {"name": "raw_location", "type": "string", "required": false, "header_required": false},
    {"name": "license_status", "type": "enum", "required": false, "header_required": false, "allowed": ["permitted", "restricted", "unknown", "not_applicable", "review_required"]},
