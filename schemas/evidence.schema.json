    {"name": "supersedes_evidence_id", "type": "string", "required": false, "header_required": false},
    {"name": "content_hash_status", "type": "enum", "required": false, "header_required": false, "allowed": ["verified", "recorded_unverified", "not_recorded", "not_applicable", "mismatch"]},
