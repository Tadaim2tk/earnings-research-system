{
  "$defs": {
    "HorizonReturn": {
      "properties": {
        "horizon": {
          "enum": [
            "D1",
            "D5",
            "D20"
          ],
          "title": "Horizon",
          "type": "string"
        },
        "status": {
          "enum": [
            "comparable",
            "not_comparable"
          ],
          "title": "Status",
          "type": "string"
        },
        "return_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Value"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        }
      },
      "required": [
        "horizon",
        "status",
        "observed_at",
        "source_record_id"
      ],
      "title": "HorizonReturn",
      "type": "object"
    },
    "PostEventFeatures": {
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "reaction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction"
        }
      },
      "required": [
        "captured_at"
      ],
      "title": "PostEventFeatures",
      "type": "object"
    },
    "PreEventFeatures": {
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "baseline_id": {
          "title": "Baseline Id",
          "type": "string"
        },
        "baseline_version": {
          "minimum": 1,
          "title": "Baseline Version",
          "type": "integer"
        },
        "baseline_record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Record Hash",
          "type": "string"
        },
        "locked_at": {
          "format": "date-time",
          "title": "Locked At",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "narrative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative"
        },
        "judge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        },
        "risk_balance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Balance"
        },
        "volatility_environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volatility Environment"
        },
        "dollar_environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dollar Environment"
        }
      },
      "required": [
        "captured_at",
        "baseline_id",
        "baseline_version",
        "baseline_record_hash",
        "locked_at"
      ],
      "title": "PreEventFeatures",
      "type": "object"
    }
  },
  "allOf": [
    {
      "else": {
        "properties": {
          "supersedes_observation_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "supersedes_observation_id"
        ]
      },
      "if": {
        "properties": {
          "observation_version": {
            "const": 1
          }
        },
        "required": [
          "observation_version"
        ]
      },
      "then": {
        "properties": {
          "supersedes_observation_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "prospective_hypothesis_event_observation_v2",
      "default": "prospective_hypothesis_event_observation_v2",
      "title": "Schema Version",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "observation_version": {
      "minimum": 1,
      "title": "Observation Version",
      "type": "integer"
    },
    "supersedes_observation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Observation Id"
    },
    "observation_stage": {
      "enum": [
        "D1",
        "D5",
        "D20"
      ],
      "title": "Observation Stage",
      "type": "string"
    },
    "earnings_event_id": {
      "title": "Earnings Event Id",
      "type": "string"
    },
    "company_name": {
      "title": "Company Name",
      "type": "string"
    },
    "ticker": {
      "title": "Ticker",
      "type": "string"
    },
    "event_quarter": {
      "pattern": "^\\d{4}-Q[1-4]$",
      "title": "Event Quarter",
      "type": "string"
    },
    "event_occurred_at": {
      "format": "date-time",
      "title": "Event Occurred At",
      "type": "string"
    },
    "observed_through": {
      "format": "date-time",
      "title": "Observed Through",
      "type": "string"
    },
    "pre_event_features": {
      "$ref": "#/$defs/PreEventFeatures"
    },
    "post_event_features": {
      "$ref": "#/$defs/PostEventFeatures"
    },
    "returns": {
      "items": {
        "$ref": "#/$defs/HorizonReturn"
      },
      "title": "Returns",
      "type": "array"
    },
    "source_record_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Record Ids",
      "type": "array"
    },
    "prospective_record": {
      "const": true,
      "default": true,
      "title": "Prospective Record",
      "type": "boolean"
    },
    "production_rules_modified": {
      "const": false,
      "default": false,
      "title": "Production Rules Modified",
      "type": "boolean"
    },
    "scoring_weights_modified": {
      "const": false,
      "default": false,
      "title": "Scoring Weights Modified",
      "type": "boolean"
    },
    "trade_decision_included": {
      "const": false,
      "default": false,
      "title": "Trade Decision Included",
      "type": "boolean"
    }
  },
  "required": [
    "observation_id",
    "observation_version",
    "observation_stage",
    "earnings_event_id",
    "company_name",
    "ticker",
    "event_quarter",
    "event_occurred_at",
    "observed_through",
    "pre_event_features",
    "post_event_features",
    "returns",
    "source_record_ids"
  ],
  "title": "CompletedEventObservation",
  "type": "object"
}
