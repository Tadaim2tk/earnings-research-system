{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ers/legacy_migration_manifest.schema.json",
  "title": "Legacy OS Migration Manifest",
  "type": "object",
  "required": [
    "schema_version", "dataset_origin", "record_mode", "migration_version",
    "mapping_version", "migration_recorded_at", "source_repository",
    "frozen_source_commit", "source_workflow_run_id", "source_sha256", "source_row_count",
    "source_column_count", "source_header", "source_history_commit_count",
    "tso_repository", "tso_source_commit", "tso_link_row_count",
    "tso_context_snapshot_count", "output_sha256", "reports_sha256", "prospective_records_created",
    "formal_evidence_created", "tso_writeback_performed"
  ],
  "properties": {
    "schema_version": {"const": "legacy_migration_manifest_v1"},
    "dataset_origin": {"const": "earnings-research-os"},
    "record_mode": {"const": "legacy_observational"},
    "migration_version": {"type": "string"},
    "mapping_version": {"type": "string"},
    "migration_recorded_at": {"type": "string", "format": "date-time"},
    "source_repository": {"type": "string"},
    "source_branch": {"const": "main"},
    "frozen_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_workflow_run_id": {"type": "string", "minLength": 1},
    "source_path": {"const": "data/records.csv"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_row_count": {"type": "integer", "minimum": 1},
    "source_column_count": {"const": 29},
    "source_header": {"type": "array", "minItems": 29, "maxItems": 29, "uniqueItems": true},
    "source_history_commit_count": {"type": "integer", "minimum": 1},
    "source_first_commit": {"type": "string"},
    "source_last_commit": {"type": "string"},
    "tso_repository": {"type": "string"},
    "tso_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tso_link_row_count": {"type": "integer", "minimum": 1},
    "tso_context_snapshot_count": {"type": "integer", "minimum": 1},
    "tso_join_status_counts": {"type": "object"},
    "output_sha256": {"type": "object"},
    "reports_sha256": {"type": "object"},
    "prospective_records_created": {"const": 0},
    "formal_evidence_created": {"const": 0},
    "tso_writeback_performed": {"const": false}
  },
  "additionalProperties": false
}
