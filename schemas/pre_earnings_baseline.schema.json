    {"name": "nearby_sector_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "external_environment_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "sentiment_balance_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "meme_overheat_penalty", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "expectation_overheat_penalty", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "credit_supply_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "short_interest_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "valuation_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "value_trap_penalty", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "governance_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "capital_allocation_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "historical_reaction_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "analyst_coverage_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "liquidity_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "pre_event_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "pre_event_grade", "type": "enum", "required": true, "allowed": ["A", "B", "C", "D", "NO_TRADE"]},
    {"name": "pre_event_decision", "type": "enum", "required": true, "allowed": ["WATCH", "LONG_CANDIDATE", "SHORT_CANDIDATE", "NO_TRADE"]},
    {"name": "pre_event_reason", "type": "string", "required": true},
    {"name": "scoring_version", "type": "string", "required": true},
