    {"name": "company_guidance_eps", "type": "decimal", "required": false},
    {"name": "guidance_style", "type": "enum", "required": true, "allowed": ["conservative", "neutral", "aggressive", "none", "unknown"]},
    {"name": "guidance_reliability_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "earnings_quality_score", "type": "decimal", "required": true, "min": 0, "max": 100},
    {"name": "peer_trend_score", "type": "decimal", "required": true, "min": 0, "max": 100},
